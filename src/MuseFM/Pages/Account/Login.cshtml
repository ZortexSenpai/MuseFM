@page "/login"
@model MuseFM.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}
<div class="auth">
<aside class="auth-side">
    <h2>Welcome back.</h2>
    <p>Your charts kept counting while you were away.</p>
    <span class="disc" aria-hidden="true"></span>
</aside>
<div class="auth-card">
    <h1>Log in</h1>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="alert error"></div>
        <label class="field">
            <span>Username</span>
            <input asp-for="Input.Username" autocomplete="username" autofocus>
            <span asp-validation-for="Input.Username" class="field-error"></span>
        </label>
        <label class="field">
            <span>Password</span>
            <input asp-for="Input.Password" autocomplete="current-password">
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </label>
        <label class="check">
            <input asp-for="Input.RememberMe"> Keep me signed in
        </label>
        <button type="submit" class="button primary wide">Log in</button>
    </form>
    @if (Model.RegistrationOpen)
    {
        <p class="muted center">No account yet? <a href="/register">Sign up</a></p>
    }
</div>
</div>
