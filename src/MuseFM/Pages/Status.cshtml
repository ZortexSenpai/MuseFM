@page "/status/{code:int}"
@model StatusModel
@{
    ViewData["Title"] = Model.Heading;
}
<section class="lost">
    <div class="status-disc"><h1 class="status-code">@Model.Code</h1></div>
    <div>
        <p class="eyebrow">This side is blank</p>
        <h2>@Model.Heading</h2>
        <p class="muted">@Model.Message</p>
        <a class="button" href="/">Back to start</a>
    </div>
</section>
