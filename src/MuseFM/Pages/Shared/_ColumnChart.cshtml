@model ChartModel
@{
    var max = Model.Groups.SelectMany(g => g.Values).Select(v => v ?? 0).DefaultIfEmpty(0).Max();
    var (top, ticks) = Ui.NiceScale(max);
    var single = Model.Series.Count == 1;
}
@if (max == 0)
{
    <p class="empty-note">Nothing in this period.</p>
}
else
{
    <figure class="chart columns-chart@(single ? "" : " paired")">
        <partial name="_ChartLegend" model="Model" />
        <div class="chart-body" role="img" aria-label="@Model.Caption" style="--y-chars:@Ui.Compact(top).Length">
            <div class="axis-y" aria-hidden="true">
                @foreach (var tick in ticks)
                {
                    <span style="bottom:@Ui.Percent(tick, top)">@Ui.Compact(tick)</span>
                }
            </div>
            <div class="plot">
                <div class="gridlines" aria-hidden="true">
                    @foreach (var tick in ticks)
                    {
                        <i style="bottom:@Ui.Percent(tick, top)"></i>
                    }
                </div>
                <div class="columns">
                    @foreach (var group in Model.Groups)
                    {
                        var rows = Model.Series.Select((s, i) => (group.Values[i] is { } v ? Ui.Number(v) : "—", single ? Model.Unit : s.Name, (string?)s.Key));
                        <div class="column" data-tip="@Ui.Tip(group.Title, rows)">
                            @for (var i = 0; i < Model.Series.Count; i++)
                            {
                                var value = group.Values[i] ?? 0;
                                <span class="bar @Model.Series[i].Key@(value == 0 ? " zero" : "")" style="height:@Ui.Percent(value, top)"></span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="axis-x" aria-hidden="true">
                @foreach (var group in Model.Groups)
                {
                    <span>@group.Label</span>
                }
            </div>
        </div>
        <partial name="_ChartTable" model="Model" />
    </figure>
}
