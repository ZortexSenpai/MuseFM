@model PagerModel
@if (Model.TotalPages > 1)
{
    <nav class="pager" aria-label="Pagination">
        @if (Model.Page > 1)
        {
            <a class="button small" href="@Model.UrlFor(Model.Page - 1)">← Previous</a>
        }
        <span class="muted">Page @Model.Page of @Ui.Number(Model.TotalPages)</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a class="button small" href="@Model.UrlFor(Model.Page + 1)">Next →</a>
        }
    </nav>
}
